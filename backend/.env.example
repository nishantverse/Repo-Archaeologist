# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: "groq" | "ollama"
# Defaults to "groq" if not set.
LLM_PROVIDER=groq

# ─── Groq (cloud) ──────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=


# Model to use with Groq. Default: llama-3.2-1b-preview
# GROQ_MODEL=llama-3.2-1b-preview

# ─── Ollama (local) ────────────────────────────────────────────────────────────
# Base URL of your local Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434

# Model to use with Ollama. Must already be pulled locally (e.g. ollama pull llama3).
OLLAMA_MODEL=llama3.2

# ─── Context window budget (in tokens, rough estimate: 1 token ≈ 4 chars) ─────
# How much of the codebase to feed to the LLM.
# Small/local models (llama3.2:1b): keep this at 3000-6000
# Larger models (llama3, groq): 8000-24000 is fine
LLM_CONTEXT_TOKENS=6000
